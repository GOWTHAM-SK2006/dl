import cv2
import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path
from tensorflow.keras.preprocessing.image import ImageDataGenerator

image_path = next(
    (path for path in (Path(__file__).with_name("Image_1.jfif"),
                       Path(__file__).with_name("img.png"))
     if path.exists()),
    None,
)
if image_path is None:
    raise FileNotFoundError(
        "Place Image_1.jfif or img.png in the same folder as this script."
    )

color = cv2.imread(str(image_path))
if color is None:
    raise ValueError(f"OpenCV could not read image: {image_path}")
img = cv2.cvtColor(color, cv2.COLOR_BGR2GRAY)

# Histogram Equalization
equ = cv2.equalizeHist(img)

# Edge Detection
blur = cv2.GaussianBlur(img, (5,5), 0)
edges = cv2.Canny(blur, 100, 200)

# Thresholding
_, binary = cv2.threshold(img, 127, 255, cv2.THRESH_BINARY)

# Morphological Operations
kernel = np.ones((5,5), np.uint8)
erosion = cv2.erode(binary, kernel, iterations=1)
dilation = cv2.dilate(binary, kernel, iterations=1)

# Data Augmentation
color = cv2.cvtColor(color, cv2.COLOR_BGR2RGB)
data = ImageDataGenerator(rotation_range=40, zoom_range=0.2, horizontal_flip=True)
gen = data.flow(np.expand_dims(color, 0), batch_size=1)

# Display Results
images = [img, equ, edges, binary, erosion, dilation]
titles = ["Original", "Equalization", "Edges", "Threshold", "Erosion", "Dilation"]

for i in range(6):
    plt.subplot(2,3,i+1)
    plt.imshow(images[i], cmap='gray')
    plt.title(titles[i])
    plt.axis('off')

plt.show()

plt.imshow(next(gen)[0].astype('uint8'))
plt.title("Data Augmentation")
plt.axis('off')
plt.show()


